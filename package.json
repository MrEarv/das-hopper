{
  "name": "das-hopper",
  "version": "1.0.0",
  "description": "Herramienta de respaldo ADB",
  "author": "MrEarv",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.mrearv.dashopper",
    "productName": "Das-Hopper",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "bin/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Das-Hopper"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^24.13.3"
  }
}